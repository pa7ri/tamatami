-- Migrate schema v1 -> v2: add medication frequency (how often a dose is due).
-- frequencyKind = FrequencyKind ordinal (0 = DAILY, the pre-existing behaviour);
-- frequencyValue = kind-specific payload (interval for EVERY_N_DAYS, weekday
-- bitmask for WEEKLY). Existing rows default to daily.
ALTER TABLE medication ADD COLUMN frequencyKind INTEGER NOT NULL DEFAULT 0;
ALTER TABLE medication ADD COLUMN frequencyValue INTEGER NOT NULL DEFAULT 0;
